{
  "site_url": "https://yourcompany.grohrms.cloud",
  "api_key": "",
  "api_secret": "",
  "connector": "Head Office Agent",
  "poll_interval_seconds": 300,
  "batch_size": 200,
  "max_attempts": 10,
  "request_timeout_seconds": 60,
  "verify_tls": true,
  "proxy": null,
  "log_dir": "logs",
  "spool_path": "spool.sqlite3",
  "sources": {
    "_note": "Only for readers whose punches live in attendance-software database (driver 'SQL Database' or 'WDMS'). Keyed by device name, serial, or '*'. Delete this block for ZKTeco readers polled over the LAN.",
    "*": {
      "engine": "mysql",
      "host": "127.0.0.1",
      "port": 3306,
      "database": "",
      "user": "",
      "password": "",
      "table": "iclock_transaction",
      "user_column": "emp_code",
      "time_column": "punch_time",
      "serial_column": "terminal_sn",
      "state_column": "punch_state",
      "lookback_minutes": 1440,
      "initial_days": 7,
      "max_rows": 5000
    }
  }
}
